# Satellite Daemon Configuration
# Copy this file to /etc/satellite-daemon/config.yaml

# Server WebSocket URL (required)
# This is the GalleryControl server the satellite will connect to
server_url: wss://gallerycontrol.example.com

# Optional settings
# reconnect_delay: 5.0        # Seconds to wait before reconnecting
# heartbeat_interval: 30.0    # Seconds between heartbeats
# command_timeout: 30.0       # Seconds to wait for command completion
