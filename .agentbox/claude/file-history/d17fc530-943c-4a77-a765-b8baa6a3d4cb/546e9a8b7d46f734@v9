    </div>
  </div>

  <!-- Exhibition Overview - Compact Cards with Dots -->
  <div class="overview-section">
    <div class="exhibition-card">
      <div class="exhibition-card-name" onclick="scrollToExhibition('exhibition-1')" style="cursor: pointer;">Permanente Ausstellung</div>
      <div class="exhibition-card-stats">
        <span class="stat-dot on"></span><span class="stat-count">12</span>
        <span class="stat-dot off"></span><span class="stat-count">3</span>
        <span class="stat-dot error"></span><span class="stat-count">1</span>
      </div>
      <div class="exhibition-card-controls">
        <button class="btn btn-success btn-sm">ON</button>
        <button class="btn btn-danger btn-sm">OFF</button>
      </div>
    </div>

    <div class="exhibition-card">
      <div class="exhibition-card-name" onclick="scrollToExhibition('exhibition-2')" style="cursor: pointer;">Sonderausstellung Frühjahr</div>
      <div class="exhibition-card-stats">
        <span class="stat-dot on"></span><span class="stat-count">2</span>
        <span class="stat-dot off"></span><span class="stat-count">4</span>
      </div>
      <div class="exhibition-card-controls">
        <button class="btn btn-success btn-sm">ON</button>
        <button class="btn btn-danger btn-sm">OFF</button>
      </div>
    </div>

    <div class="exhibition-card" style="opacity: 0.6;">
      <div class="exhibition-card-name" onclick="scrollToExhibition('exhibition-3')" style="cursor: pointer;">Archiv <span class="badge bg-secondary">Disabled</span></div>
      <div class="exhibition-card-stats">
        <span class="stat-dot off"></span><span class="stat-count">1</span>
      </div>
      <div class="exhibition-card-controls">
        <button class="btn btn-secondary btn-sm" disabled>OFF</button>
      </div>
    </div>
  </div>

  <!-- Exhibition 1: Permanente Ausstellung -->
  <div class="exhibition-section" id="exhibition-1">
    <div class="exhibition-header">
      <span>Permanente Ausstellung</span>
      <div class="exhibition-header-controls">
        <button class="btn btn-success btn-sm">ON</button>
        <button class="btn btn-danger btn-sm">OFF</button>
      </div>
    </div>

    <div class="artwork-table">
      <!-- Artwork Row 1 -->
      <div class="artwork-row">
        <div class="artwork-header-row">
          <div class="artwork-name">
            Raum 1.1 - Hauptgalerie
            <button class="btn btn-outline-primary btn-sm btn-add-device" onclick="window.location='prototype-forms.html'">+ Add</button>
          </div>
          <div class="artwork-controls">
            <div class="btn-group">
              <button class="btn btn-success btn-sm">ON</button>
              <button class="btn btn-danger btn-sm">OFF</button>
            </div>
          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-on has-cooldown" onclick="openDeviceAccordion(this, 'artwork-1', 'proj-left')">
            <span class="cooldown-indicator"></span>
            Projektor Links
          </div>
          <div class="device-badge device-on has-cooldown" onclick="openDeviceAccordion(this, 'artwork-1', 'proj-right')">
            <span class="cooldown-indicator"></span>
            Projektor Rechts
          </div>
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-1', 'led-1')">
            LED Panel 1
          </div>
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-1', 'led-2')">
            LED Panel 2
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 1 -->
      <div class="device-accordion" id="accordion-artwork-1">
        <div class="accordion-header" id="accordion-title-artwork-1">Device Controls</div>
        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-1">-</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-1">-</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-1">-</span></span>
          <span id="device-cooldown-wrapper-artwork-1"><strong>Cooldown:</strong> <span id="device-cooldown-artwork-1">-</span></span>
        </div>
        <div class="device-actions">
          <button class="btn btn-success btn-sm" onclick="sendCommand('on')">ON</button>
          <button class="btn btn-danger btn-sm" onclick="sendCommand('off')">OFF</button>
          <button class="btn btn-info btn-sm" onclick="sendCommand('state')">State</button>
          <button class="btn btn-secondary btn-sm" onclick="openDeviceSettings()">Settings</button>
        </div>
      </div>

      <!-- Artwork Row 2 -->
      <div class="artwork-row">
        <div class="artwork-header-row">
          <div class="artwork-name">
            Raum 1.2 - Seitenflügel
            <button class="btn btn-outline-primary btn-sm btn-add-device" onclick="window.location='prototype-forms.html'">+ Add</button>
          </div>
          <div class="artwork-controls">
            <div class="btn-group">
              <button class="btn btn-success btn-sm">ON</button>
              <button class="btn btn-danger btn-sm">OFF</button>
            </div>
          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-on has-cooldown" onclick="openDeviceAccordion(this, 'artwork-2', 'beamer-1')">
            <span class="cooldown-indicator"></span>
            Beamer Nord
          </div>
          <div class="device-badge device-cooling has-cooldown" onclick="openDeviceAccordion(this, 'artwork-2', 'beamer-2')">
            <span class="cooldown-indicator"></span>
            Beamer Süd
          </div>
          <div class="device-badge device-on" onclick="openDeviceAccordion(this, 'artwork-2', 'audio-1')">
            Audio System
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 2 -->
      <div class="device-accordion" id="accordion-artwork-2">
        <div class="accordion-header" id="accordion-title-artwork-2">Device Controls</div>
        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-2">-</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-2">-</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-2">-</span></span>
          <span id="device-cooldown-wrapper-artwork-2"><strong>Cooldown:</strong> <span id="device-cooldown-artwork-2">-</span></span>
        </div>
        <div class="device-actions">
          <button class="btn btn-success btn-sm" onclick="sendCommand('on')">ON</button>
          <button class="btn btn-danger btn-sm" onclick="sendCommand('off')">OFF</button>
          <button class="btn btn-info btn-sm" onclick="sendCommand('state')">State</button>
          <button class="btn btn-secondary btn-sm" onclick="openDeviceSettings()">Settings</button>
        </div>
      </div>

      <!-- Artwork Row 3 - Manual Only -->
      <div class="artwork-row">
        <div class="artwork-header-row">
          <div class="artwork-name artwork-name-manual">
            Raum 1.3 - Medienraum
            <span class="manual-badge">Manual</span>
            <button class="btn btn-outline-primary btn-sm btn-add-device" onclick="window.location='prototype-forms.html'">+ Add</button>
          </div>
          <div class="artwork-controls">
            <div class="manual-commands">
              <button class="btn btn-primary btn-sm" onclick="sendCommand('restart')">Restart</button>
              <button class="btn btn-warning btn-sm" onclick="sendCommand('backup')">Backup</button>
              <button class="btn btn-secondary btn-sm" onclick="sendCommand('status')">Status</button>
            </div>
          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-3', 'media-1')">
            Media Server
          </div>
          <div class="device-badge device-on" onclick="openDeviceAccordion(this, 'artwork-3', 'backup-1')">
            Backup Server
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 3 -->
      <div class="device-accordion" id="accordion-artwork-3">
        <div class="accordion-header" id="accordion-title-artwork-3">Device Info</div>
        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-3">-</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-3">-</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-3">-</span></span>
        </div>
        <div class="device-actions">
          <button class="btn btn-secondary btn-sm" onclick="openDeviceSettings()">Settings</button>
        </div>
      </div>

      <!-- Artwork Row 4 -->
      <div class="artwork-row">
        <div class="artwork-header-row">
          <div class="artwork-name">
            Raum 1.4 - Interaktiv
            <button class="btn btn-outline-primary btn-sm btn-add-device" onclick="window.location='prototype-forms.html'">+ Add</button>
          </div>
          <div class="artwork-controls">
            <div class="btn-group">
              <button class="btn btn-success btn-sm">ON</button>
              <button class="btn btn-danger btn-sm">OFF</button>
            </div>
          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-error" onclick="openDeviceAccordion(this, 'artwork-4', 'touch-1')">
            Touch Display
          </div>
          <div class="device-badge device-on" onclick="openDeviceAccordion(this, 'artwork-4', 'pc-1')">
            PC Station 1
          </div>
          <div class="device-badge device-on" onclick="openDeviceAccordion(this, 'artwork-4', 'pc-2')">
            PC Station 2
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 4 -->
      <div class="device-accordion" id="accordion-artwork-4">
        <div class="accordion-header" id="accordion-title-artwork-4">Device Controls</div>
        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-4">-</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-4">-</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-4">-</span></span>
        </div>
        <div class="device-actions">
          <button class="btn btn-success btn-sm" onclick="sendCommand('on')">ON</button>
          <button class="btn btn-danger btn-sm" onclick="sendCommand('off')">OFF</button>
          <button class="btn btn-info btn-sm" onclick="sendCommand('state')">State</button>
          <button class="btn btn-secondary btn-sm" onclick="openDeviceSettings()">Settings</button>
        </div>
      </div>
