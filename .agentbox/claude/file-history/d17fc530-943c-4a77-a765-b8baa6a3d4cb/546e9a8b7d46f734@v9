          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-6', 'video-1')">
            Video Wall 1
          </div>
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-6', 'video-2')">
            Video Wall 2
          </div>
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-6', 'audio-2')">
            Audio System
          </div>
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-6', 'ambient-1')">
            Ambient Light
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 6 -->
      <div class="device-accordion" id="accordion-artwork-6">
