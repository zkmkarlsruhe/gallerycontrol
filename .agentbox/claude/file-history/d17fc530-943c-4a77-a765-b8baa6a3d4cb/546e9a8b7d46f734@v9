        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-5">-</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-5">-</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-5">-</span></span>
          <span id="device-cooldown-wrapper-artwork-5"><strong>Cooldown:</strong> <span id="device-cooldown-artwork-5">-</span></span>
