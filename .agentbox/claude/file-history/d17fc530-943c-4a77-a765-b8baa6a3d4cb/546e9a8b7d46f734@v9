    </div>
  </div>

  <!-- Exhibition 3: Archiv (Disabled) -->
  <div class="exhibition-section" id="exhibition-3" style="opacity: 0.6;">
    <div class="exhibition-header" style="background: #6c757d;">
      <span>Archiv <span class="badge bg-dark">Disabled</span></span>
      <div class="exhibition-header-controls">
        <button class="btn btn-secondary btn-sm" disabled>OFF</button>
      </div>
    </div>

    <div class="artwork-table">
      <div class="artwork-row">
        <div class="artwork-header-row">
          <div class="artwork-name">
            Raum 3.1 - Lagerraum
            <button class="btn btn-outline-secondary btn-sm btn-add-device" disabled>+ Add</button>
          </div>
          <div class="artwork-controls">
            <button class="btn btn-secondary btn-sm" disabled>Manual</button>
          </div>
        </div>
        <div class="devices-container">
          <div class="device-badge device-off" onclick="openDeviceAccordion(this, 'artwork-7', 'storage-1')">
            Storage PC
          </div>
        </div>
      </div>

      <!-- Accordion for Artwork 7 -->
      <div class="device-accordion" id="accordion-artwork-7">
        <div class="accordion-header" id="accordion-title-artwork-7">Device Info</div>
        <div class="device-info-compact">
          <span><strong>Host:</strong> <span id="device-host-artwork-7">192.168.1.200</span></span>
          <span><strong>Type:</strong> <span id="device-type-artwork-7">Shell</span></span>
          <span><strong>State:</strong> <span id="device-state-artwork-7">OFF</span></span>
        </div>
        <div class="device-actions">
          <button class="btn btn-secondary btn-sm" disabled>Device Disabled</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentOpenAccordion = null;
    let currentActiveDevice = null;

    // Mock device data
    const deviceData = {
      'proj-left': { name: 'Projektor Links', host: '192.168.10.45', type: 'PJLink', state: 'ON', cooldown: '23s' },
      'proj-right': { name: 'Projektor Rechts', host: '192.168.10.46', type: 'PJLink', state: 'ON', cooldown: '15s' },
      'led-1': { name: 'LED Panel 1', host: '192.168.50.12:3', type: 'ANEL', state: 'OFF', cooldown: '-' },
      'led-2': { name: 'LED Panel 2', host: '192.168.50.12:2', type: 'ANEL', state: 'OFF', cooldown: '-' },
      'beamer-1': { name: 'Beamer Nord', host: '192.168.10.50', type: 'PJLink', state: 'ON', cooldown: '28s' },
      'beamer-2': { name: 'Beamer Süd', host: '192.168.10.51', type: 'PJLink', state: 'Cooling', cooldown: '8s' },
      'audio-1': { name: 'Audio System', host: '192.168.15.20:1', type: 'NETIO', state: 'ON', cooldown: '-' },
      'media-1': { name: 'Media Server', host: '192.168.1.100', type: 'Shell', state: 'OFF', cooldown: '-' },
      'backup-1': { name: 'Backup Server', host: '192.168.1.101', type: 'Shell', state: 'ON', cooldown: '-' },
      'touch-1': { name: 'Touch Display', host: '192.168.10.70', type: 'PJLink', state: 'ERROR', cooldown: '-' },
      'pc-1': { name: 'PC Station 1', host: '192.168.1.80', type: 'Shell', state: 'ON', cooldown: '-' },
      'pc-2': { name: 'PC Station 2', host: '192.168.1.81', type: 'Shell', state: 'ON', cooldown: '-' },
      'proj-3': { name: 'Projektor Mitte', host: '192.168.10.90', type: 'PJLink', state: 'ON', cooldown: '30s' },
      'light-1': { name: 'Licht System', host: '192.168.50.20:1', type: 'ANEL', state: 'ON', cooldown: '22s' },
      'video-1': { name: 'Video Wall 1', host: '192.168.10.95', type: 'PJLink', state: 'OFF', cooldown: '-' },
      'video-2': { name: 'Video Wall 2', host: '192.168.10.96', type: 'PJLink', state: 'OFF', cooldown: '-' },
      'audio-2': { name: 'Audio System', host: '192.168.15.30:1', type: 'NETIO', state: 'OFF', cooldown: '-' },
      'ambient-1': { name: 'Ambient Light', host: '192.168.50.21:2', type: 'ANEL', state: 'OFF', cooldown: '-' },
      'storage-1': { name: 'Storage PC', host: '192.168.1.200', type: 'Shell', state: 'OFF', cooldown: '-' }
    };

    function toggleEditMode(checkbox) {
      if (checkbox.checked) {
        document.body.classList.add('edit-mode');
      } else {
        document.body.classList.remove('edit-mode');
      }
    }

    function openDeviceAccordion(deviceElement, artworkId, deviceId) {
      const accordion = document.getElementById('accordion-' + artworkId);

      // Toggle: if clicking same device, close accordion
      if (currentActiveDevice === deviceElement && accordion.classList.contains('open')) {
        closeAccordion(artworkId);
        return;
      }

      // Close current accordion if different artwork
      if (currentOpenAccordion && currentOpenAccordion !== artworkId) {
        closeAccordion(currentOpenAccordion);
      }

      // Remove active class from previous device
      if (currentActiveDevice) {
        currentActiveDevice.classList.remove('active');
      }

      // Add active class to clicked device
      deviceElement.classList.add('active');
      currentActiveDevice = deviceElement;

      const device = deviceData[deviceId];

      if (device) {
        // Update accordion content
        document.getElementById('accordion-title-' + artworkId).textContent = device.name;
        document.getElementById('device-host-' + artworkId).textContent = device.host;
        document.getElementById('device-type-' + artworkId).textContent = device.type;
        document.getElementById('device-state-' + artworkId).textContent = device.state;

        const cooldownEl = document.getElementById('device-cooldown-' + artworkId);
        if (cooldownEl) {
          cooldownEl.textContent = device.cooldown !== '-' ? device.cooldown + ' remaining' : 'Ready';
        }
      }

      // Open accordion
      accordion.classList.add('open');
      currentOpenAccordion = artworkId;
    }

    function closeAccordion(artworkId) {
      const accordion = document.getElementById('accordion-' + artworkId);
      accordion.classList.remove('open');

      // Remove active class from device
      if (currentActiveDevice) {
        currentActiveDevice.classList.remove('active');
        currentActiveDevice = null;
      }

      if (currentOpenAccordion === artworkId) {
        currentOpenAccordion = null;
      }
    }

    function sendCommand(command) {
      alert('Sending ' + command.toUpperCase() + ' command to device');
    }

    function openDeviceSettings() {
      alert('Opening device settings');
    }

    function scrollToExhibition(id) {
      document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Close accordion when clicking outside
    document.addEventListener('click', function(event) {
      if (currentOpenAccordion &&
          !event.target.closest('.device-accordion') &&
          !event.target.closest('.device-badge')) {
        closeAccordion(currentOpenAccordion);
      }
    });
  </script>

</body>
