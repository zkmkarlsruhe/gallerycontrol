<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Context Menu
  function showContextMenu(event) {
    event.preventDefault();
    event.stopPropagation();
    const menu = document.getElementById('contextMenu');
    menu.classList.remove('hidden');
    menu.style.left = event.pageX + 'px';
    menu.style.top = event.pageY + 'px';
  }

  function hideContextMenu() {
    document.getElementById('contextMenu').classList.add('hidden');
  }

  document.addEventListener('click', hideContextMenu);

  // Modal Management
  function showModal(modalId) {
    document.getElementById(modalId).classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hideModal(modalId) {
    document.getElementById(modalId).classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Shell Automation Mode Toggle
  function toggleShellMode(checkbox) {
    const autoOn = document.getElementById('automationOnMode');
    const autoOff = document.getElementById('automationOffMode');

    if (checkbox.checked) {
      autoOn.classList.remove('hidden');
      autoOff.classList.add('hidden');
    } else {
      autoOn.classList.add('hidden');
      autoOff.classList.remove('hidden');
    }
  }

  // Command Testing
  function testCommand(button) {
    const input = button.previousElementSibling;
    const command = input.value;

    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Testing...';

    setTimeout(() => {
      const commandItem = button.closest('.command-item');
      let output = commandItem.querySelector('.command-output');

      if (!output) {
        output = document.createElement('div');
        output.className = 'command-output';
        commandItem.appendChild(output);
      }

      output.innerHTML = `$ ${command}\n\n` +
        `✓ Command executed successfully\n` +
        `Exit code: 0\n` +
        `Output: [Sample output would appear here]`;

      button.disabled = false;
      button.innerHTML = '<i class="bi bi-play-fill"></i> Test';
    }, 1000);
  }

  // Template Selection
  function selectTemplate(card) {
    document.querySelectorAll('.template-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
  }

  function showTemplateDetails(card, templateId) {
    const details = document.getElementById('templateDetails');
    details.classList.remove('hidden');

    const templates = {
      systemd: {
        name: 'Systemd Service Control',
        variables: [
          { name: 'SERVICE_NAME', placeholder: 'myapp', desc: 'Name of the systemd service' },
          { name: 'HOST', placeholder: 'server.local', desc: 'Server hostname or IP' }
        ],
        commands: [
          { name: 'Reachable', cmd: 'ping -c 1 {{HOST}}' },
          { name: 'Status', cmd: 'systemctl status {{SERVICE_NAME}}', patterns: true },
          { name: 'ON', cmd: 'systemctl start {{SERVICE_NAME}}' },
          { name: 'OFF', cmd: 'systemctl stop {{SERVICE_NAME}}' }
        ]
      },
      maintenance: {
        name: 'Server Maintenance',
        variables: [
          { name: 'HOST', placeholder: 'server.local', desc: 'Server hostname or IP' }
        ],
        commands: [
          { name: 'Restart', cmd: 'ssh {{HOST}} "sudo reboot"' },
          { name: 'Update', cmd: 'ssh {{HOST}} "sudo apt update && sudo apt upgrade -y"' },
          { name: 'Cleanup', cmd: 'ssh {{HOST}} "sudo apt autoremove -y"' },
          { name: 'Disk Space', cmd: 'ssh {{HOST}} "df -h"' }
        ]
      }
    };

    const template = templates[templateId];

    let html = `<h6>${template.name}</h6>`;
    html += `<div class="mb-3"><strong>Variables:</strong></div>`;

    template.variables.forEach(v => {
      html += `
        <div class="variable-input">
          <label class="form-label small">${v.name}</label>
          <input type="text" class="form-control form-control-sm" placeholder="${v.placeholder}">
          <div class="form-text">${v.desc}</div>
        </div>
      `;
    });

    html += `<div class="mt-3 mb-2"><strong>Commands Preview:</strong></div>`;
    template.commands.forEach(c => {
      html += `<div class="small mb-1"><code>${c.cmd}</code></div>`;
    });

    html += `<div class="mt-3">
      <button class="btn btn-primary btn-sm" onclick="alert('Template applied!'); hideModal('templateModal')">
        Apply Template
      </button>
      <button class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('templateDetails').classList.add('hidden')">
        Cancel
      </button>
    </div>`;

    details.innerHTML = html;
  }

  // Section Toggle
  function toggleSection(header) {
    const body = header.nextElementSibling;
    const icon = header.querySelector('i');

    body.classList.toggle('hidden');
    icon.classList.toggle('bi-chevron-down');
    icon.classList.toggle('bi-chevron-up');
  }

  // Update Artwork List
  function updateArtworkList(select) {
    const artworks = {
      '1': ['Interactive Display', 'Video Wall', 'Sound Installation'],
      '2': ['Touch Screen', 'Light Installation'],
      '3': ['Welcome Screen', 'Info Display']
    };

    const artworkSelect = document.getElementById('artworkSelect');
    artworkSelect.innerHTML = '';

    artworks[select.value].forEach((artwork, i) => {
      const option = document.createElement('option');
      option.value = i;
      option.textContent = artwork;
      artworkSelect.appendChild(option);
    });
  }

  function confirmDelete() {
    if (confirm('Delete this device?\n\nThis action cannot be undone.')) {
      alert('Device deleted!');
    }
  }
</script>

