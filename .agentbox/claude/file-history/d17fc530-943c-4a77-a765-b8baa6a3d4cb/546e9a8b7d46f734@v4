        </div>
        <div class="overview-controls">
          <button class="btn btn-success btn-sm" onclick="scrollToExhibition('exhibition-1')">ON</button>
          <button class="btn btn-danger btn-sm" onclick="scrollToExhibition('exhibition-1')">OFF</button>
        </div>
      </div>

      <!-- Exhibition 2 Overview -->
