version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    container_name: mutech-postgres
    environment:
      POSTGRES_DB: mutech
      POSTGRES_USER: mutech
      POSTGRES_PASSWORD: ${DB_PASSWORD:-mutech_password}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mutech"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - mutech-network
    restart: unless-stopped

  main-service:
    build:
      context: ./mutech-control-service
      dockerfile: Dockerfile
    container_name: mutech-main-service
    environment:
      DATABASE_URL: postgresql+asyncpg://mutech:${DB_PASSWORD:-mutech_password}@postgres:5432/mutech
      ANEL_RUNNER_URL: http://anel-runner:8001
      ANEL_API_KEY: ${ANEL_API_KEY:-secure-api-key-change-me}
      ENVIRONMENT: ${ENVIRONMENT:-development}
    volumes:
      - ./mutech-control-service/config:/app/config
      - ./logs:/app/logs
    ports:
      - "8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - mutech-network
    restart: unless-stopped

  anel-runner:
    build:
      context: ./anel-runner-service
      dockerfile: Dockerfile
    container_name: mutech-anel-runner
    environment:
      API_KEY: ${ANEL_API_KEY:-secure-api-key-change-me}
      PORT: 8001
      HOST: 0.0.0.0
    network_mode: host  # Required for ANEL UDP broadcast access
    restart: unless-stopped

volumes:
  postgres_data:
    driver: local

networks:
  mutech-network:
    driver: bridge
