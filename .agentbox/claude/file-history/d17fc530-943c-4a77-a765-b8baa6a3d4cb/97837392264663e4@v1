if __name__ == "__main__":
    import uvicorn

    config = get_config()
    host = config.get("server.host", "0.0.0.0")
    port = config.get("server.port", 8000)
    reload = config.get("server.reload", False)

    uvicorn.run(
        "mutech_control.main:app",
        host=host,
        port=port,
        reload=reload,
    )
