          <button class="btn btn-success btn-sm">ON</button>
          <button class="btn btn-danger btn-sm">OFF</button>
        </div>
      </div>

      <div class="exhibition-card">
        <div class="exhibition-name">Sonderausstellung 2026</div>
        <div class="exhibition-stats">
          <span class="stat-badge stat-on">6 ON</span>
          <span class="stat-badge stat-off">3 OFF</span>
          <span class="stat-badge stat-error">1 Error</span>
        </div>
        <div class="exhibition-actions">
          <button class="btn btn-success btn-sm">ON</button>
          <button class="btn btn-danger btn-sm">OFF</button>
        </div>
      </div>

      <div class="exhibition-card">
        <div class="exhibition-name">Interaktive Zone</div>
        <div class="exhibition-stats">
          <span class="stat-badge stat-on">4 ON</span>
          <span class="stat-badge stat-off">0 OFF</span>
          <span class="stat-badge stat-error">0 Errors</span>
        </div>
        <div class="exhibition-actions">
          <button class="btn btn-success btn-sm">ON</button>
          <button class="btn btn-danger btn-sm">OFF</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Table View: All Devices -->
  <div class="table-section">
    <h5 class="mb-3">All Devices</h5>

