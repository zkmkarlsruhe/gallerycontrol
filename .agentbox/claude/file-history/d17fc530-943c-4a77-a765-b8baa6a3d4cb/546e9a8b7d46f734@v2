          <div class="device-info ip-short" data-short=".10.47"><span>192.168.10.47</span></div>
          <div class="device-cooldown">Next: 8s</div>
        </div>

        <div class="device-badge device-on cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Wandbeleuchtung</div>
          <div class="device-info ip-short" data-short=".50.13:1"><span>192.168.50.13:1</span></div>
        </div>

        <div class="device-badge device-on cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Vitrinen LEDs</div>
          <div class="device-info ip-short" data-short=".50.13:2"><span>192.168.50.13:2</span></div>
        </div>
      </div>
    </div>

    <!-- Artwork: Raum 1.3 - Medienraum (No Automation) -->
    <div class="artwork-section">
      <div class="artwork-header">
        <span>Raum 1.3 - Medienraum <span class="automation-badge">No Automation</span></span>
        <div class="artwork-actions">
          <button class="btn btn-secondary btn-sm">Manual Only</button>
