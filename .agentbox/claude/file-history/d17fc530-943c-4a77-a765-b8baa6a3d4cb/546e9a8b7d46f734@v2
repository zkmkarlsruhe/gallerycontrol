          <div class="device-info">Shell: systemctl</div>
        </div>
      </div>
    </div>

    <!-- Exhibition 2: Sonderausstellung -->
    <div class="exhibition-header">
      <span>Sonderausstellung 2026</span>
      <div>
        <button class="btn btn-success btn-sm me-2">ON</button>
        <button class="btn btn-danger btn-sm">OFF</button>
