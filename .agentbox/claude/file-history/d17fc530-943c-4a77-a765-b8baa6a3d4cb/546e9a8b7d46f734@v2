    </div>

    <!-- Artwork: Installation A -->
    <div class="artwork-section">
      <div class="artwork-header">
        <span>Installation A - Lichtkunst</span>
        <div class="artwork-actions">
          <button class="btn btn-success btn-sm me-2">ON</button>
          <button class="btn btn-danger btn-sm me-2">OFF</button>
          <button class="btn btn-outline-primary btn-sm">+ Add Device</button>
        </div>
      </div>
      <div class="devices-container">
        <div class="device-badge device-on cooldown-100" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">LED Panel 1</div>
          <div class="device-info ip-short" data-short=".50.20:1"><span>192.168.50.20:1</span></div>
          <div class="device-cooldown">Next: 30s</div>
        </div>

        <div class="device-badge device-on cooldown-90" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">LED Panel 2</div>
          <div class="device-info ip-short" data-short=".50.20:2"><span>192.168.50.20:2</span></div>
          <div class="device-cooldown">Next: 27s</div>
        </div>

        <div class="device-badge device-on cooldown-80" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">LED Panel 3</div>
          <div class="device-info ip-short" data-short=".50.20:3"><span>192.168.50.20:3</span></div>
          <div class="device-cooldown">Next: 24s</div>
        </div>
      </div>
    </div>

    <!-- Artwork: Installation B -->
    <div class="artwork-section">
      <div class="artwork-header">
        <span>Installation B - Videokunst</span>
        <div class="artwork-actions">
          <button class="btn btn-success btn-sm me-2">ON</button>
          <button class="btn btn-danger btn-sm me-2">OFF</button>
          <button class="btn btn-outline-primary btn-sm">+ Add Device</button>
        </div>
      </div>
      <div class="devices-container">
        <div class="device-badge device-on cooldown-50" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Projektor Wand 1</div>
          <div class="device-info ip-short" data-short=".10.51"><span>192.168.10.51</span></div>
          <div class="device-cooldown">Next: 15s</div>
        </div>

        <div class="device-badge device-on cooldown-50" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Projektor Wand 2</div>
          <div class="device-info ip-short" data-short=".10.52"><span>192.168.10.52</span></div>
          <div class="device-cooldown">Next: 15s</div>
        </div>

        <div class="device-badge device-error cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Projektor Decke</div>
          <div class="device-info ip-short" data-short=".10.53"><span>192.168.10.53</span></div>
          <div class="device-cooldown">Error: Timeout</div>
        </div>

        <div class="device-badge device-off cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Audio Anlage</div>
          <div class="device-info ip-short" data-short=".50.21:1"><span>192.168.50.21:1</span></div>
        </div>
      </div>
    </div>

    <!-- Artwork: Installation C -->
    <div class="artwork-section">
      <div class="artwork-header">
        <span>Installation C - Interaktiv</span>
        <div class="artwork-actions">
          <button class="btn btn-success btn-sm me-2">ON</button>
          <button class="btn btn-danger btn-sm me-2">OFF</button>
          <button class="btn btn-outline-primary btn-sm">+ Add Device</button>
        </div>
      </div>
      <div class="devices-container">
        <div class="device-badge device-off cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Touch Display 1</div>
          <div class="device-info ip-short" data-short=".50.22:1"><span>192.168.50.22:1</span></div>
        </div>

        <div class="device-badge device-off cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Touch Display 2</div>
          <div class="device-info ip-short" data-short=".50.22:2"><span>192.168.50.22:2</span></div>
        </div>

        <div class="device-badge device-off cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Sensor System</div>
          <div class="device-info ip-short" data-short=".50.22:3"><span>192.168.50.22:3</span></div>
        </div>
      </div>
    </div>

    <!-- Exhibition 3: Interaktive Zone -->
    <div class="exhibition-header">
      <span>Interaktive Zone</span>
      <div>
        <button class="btn btn-success btn-sm me-2">ON</button>
        <button class="btn btn-danger btn-sm">OFF</button>
      </div>
    </div>

    <!-- Artwork: Touchscreen Station -->
    <div class="artwork-section">
      <div class="artwork-header">
        <span>Touchscreen Stationen</span>
        <div class="artwork-actions">
          <button class="btn btn-success btn-sm me-2">ON</button>
          <button class="btn btn-danger btn-sm me-2">OFF</button>
          <button class="btn btn-outline-primary btn-sm">+ Add Device</button>
        </div>
      </div>
      <div class="devices-container">
        <div class="device-badge device-on cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Station 1</div>
          <div class="device-info ip-short" data-short=".50.30:1"><span>192.168.50.30:1</span></div>
        </div>

        <div class="device-badge device-on cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Station 2</div>
          <div class="device-info ip-short" data-short=".50.30:2"><span>192.168.50.30:2</span></div>
        </div>

        <div class="device-badge device-on cooldown-0" onclick="toggleDevice(this)">
          <div class="progress-top-border"></div>
          <div class="device-name">Station 3</div>
          <div class="device-info ip-short" data-short=".50.30:3"><span>192.168.50.30:3</span></div>
        </div>
      </div>
    </div>

  </div>

</div>

<script>
  function toggleDevice(element) {
    // Toggle between on/off states for demo
    if (element.classList.contains('device-on')) {
      element.classList.remove('device-on');
      element.classList.add('device-off');
    } else if (element.classList.contains('device-off')) {
      element.classList.remove('device-off');
      element.classList.add('device-on');
      element.classList.add('cooldown-100');
    }
  }

  // Simulate cooldown progress animation
  function animateCooldowns() {
    document.querySelectorAll('.device-badge').forEach(badge => {
      if (badge.classList.contains('cooldown-100')) {
        setTimeout(() => badge.classList.replace('cooldown-100', 'cooldown-75'), 1000);
      } else if (badge.classList.contains('cooldown-75')) {
        setTimeout(() => badge.classList.replace('cooldown-75', 'cooldown-50'), 1000);
      } else if (badge.classList.contains('cooldown-50')) {
        setTimeout(() => badge.classList.replace('cooldown-50', 'cooldown-25'), 1000);
      } else if (badge.classList.contains('cooldown-25')) {
        setTimeout(() => badge.classList.replace('cooldown-25', 'cooldown-0'), 1000);
      }
    });
  }

  // Run cooldown animation every second
  setInterval(animateCooldowns, 1000);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
