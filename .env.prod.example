# Production environment variables for MuTech Control
# Copy to .env and customize as needed

# ===================
# REQUIRED
# ===================

# Database password (set a secure password!)
DB_PASSWORD=change-me-to-secure-password

# ===================
# OPTIONAL OVERRIDES
# ===================

# Log level (default: INFO)
# LOG_LEVEL=DEBUG

# Email recipient for status reports (default: marc@zkm.de)
# EMAIL_RECIPIENT=museumstechnik@zkm.de

# ===================
# ANEL RUNNER (if needed)
# ===================
# Uncomment if deploying ANEL runner service
# ANEL_API_KEY=change-me-to-secure-key
