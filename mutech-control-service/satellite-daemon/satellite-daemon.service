[Unit]
Description=MuTech Control Satellite Daemon
Documentation=https://github.com/your-org/mutech-control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=satellite
Group=satellite
ExecStart=/usr/local/bin/satellite-daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

# Config and state paths (optional, defaults shown)
# Environment=SATELLITE_CONFIG=/etc/satellite-daemon/config.yaml
# Environment=SATELLITE_STATE=/var/lib/satellite-daemon/state.yaml

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/satellite-daemon

# Allow network access
PrivateNetwork=false

[Install]
WantedBy=multi-user.target
